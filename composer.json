{
    "name": "ksfraser/ksf-fa-stock-turnover",
    "description": "FrontAccounting Stock Turnover - tracks inventory turnover, days of inventory, consumption trends",
    "type": "fa-module",
    "license": "GPL-3.0",
    "require": {
        "php": ">=7.4",
        "ksfraser/ksf-common-db": "^1.0",
        "ksfraser/exceptions": "^1.0",
        "psr/log": "^1.1|^2.0|^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0",
        "ksfraser/famock": "v0.10.4"
    },
    "autoload": {
        "psr-4": {
            "Ksfraser\\FrontAccounting\\StockTurnover\\": "src/Ksfraser/FrontAccounting/StockTurnover/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ksfraser\\Tests\\FrontAccounting\\StockTurnover\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "platform": {
            "php": "7.4.33"
        }
    }
}